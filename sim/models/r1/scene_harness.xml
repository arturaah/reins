<mujoco model="r1 harness room">
  <!-- The walk scene plus furniture and things to pick up, for harness/.
       Geoms named obstacle* are solid to the loco sim, and their box tops are
       surfaces objects can be placed on. Bodies named object_* are graspable:
       mocap bodies moved kinematically by the harness, with one geom each. -->
  <include file="scene_walk.xml"/>

  <asset>
    <material name="furniture" rgba="0.55 0.42 0.3 1"/>
    <material name="counter" rgba="0.75 0.75 0.78 1"/>
  </asset>

  <worldbody>
    <geom name="obstacle_table" type="box" pos="1.5 0 0.36" size="0.3 0.4 0.36" material="furniture" group="2" contype="0" conaffinity="0"/>
    <geom name="obstacle_counter" type="box" pos="0 2.2 0.4" size="0.7 0.3 0.4" material="counter" group="2" contype="0" conaffinity="0"/>
    <geom name="obstacle_plant" type="cylinder" pos="1.3 1.1 0.4" size="0.18 0.4" rgba="0.25 0.5 0.3 1" group="2" contype="0" conaffinity="0"/>

    <body name="object_red_cube" mocap="true" pos="1.28 0.12 0.745">
      <geom type="box" size="0.025 0.025 0.025" rgba="0.85 0.15 0.1 1" group="2" contype="0" conaffinity="0"/>
    </body>
    <body name="object_blue_bottle" mocap="true" pos="1.3 -0.2 0.79">
      <geom type="cylinder" size="0.03 0.07" rgba="0.15 0.35 0.9 1" group="2" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
